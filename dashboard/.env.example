# Base URL of the FastAPI backend (predict_api.py). No trailing slash.
# Defaults to the deployed Render API if unset — see src/api.js.
#
# For local development against a backend running on your machine, copy this
# file to .env.local and point it at localhost instead (Vite loads .env.local
# automatically, and it's already git-ignored):
#   VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=https://plant-disease-detection-resnet50.onrender.com
